# Copy to .env and fill in real values. Never commit .env.
# `docker compose` reads this automatically.

# --- Database (single source of truth — DATABASE_URL must match the parts) ---
POSTGRES_USER=poly
POSTGRES_PASSWORD=poly
POSTGRES_DB=poly_tracker
DATABASE_URL=postgres://poly:poly@db:5432/poly_tracker

# TLS to the DB. Leave unset/false for local docker-compose (plain db:5432).
# A managed cloud Postgres (Render etc.) needs TLS — set PGSSL=true there. On
# Render this is supplied by render.yaml, not this file. See DEPLOY.md.
PGSSL=false

# --- Mapbox satellite basemap ---
# Used for the "Mapbox" imagery option + the Settings token check. The "Esri"
# imagery option works with no token. Free tier is fine.
# Get one at https://account.mapbox.com/access-tokens/ (public pk.… token).
MAPBOX_TOKEN=pk.your_mapbox_token_here

# --- Host-side ports (change if one is already in use) ---
# App is served at http://localhost:${NGINX_PORT}
NGINX_PORT=8080
API_PORT=3001
WEB_PORT=5173
DB_PORT=5432

# --- Photo uploads (path inside the api container / mounted volume) ---
PHOTO_STORAGE_PATH=/data/photos

# --- Public access: Cloudflare named tunnel (stable URL) ---
# Connector token for a NAMED tunnel created in the Cloudflare Zero Trust
# dashboard (Networks > Tunnels). Gives a permanent public URL that survives
# restarts (unlike a random *.trycloudflare.com quick tunnel).
# Set the Public Hostname's service to http://localhost:8080, then paste the
# token here and run:  ./scripts/tunnel.ps1
# See README "Public access (Cloudflare named tunnel)". Leave blank if unused.
CLOUDFLARE_TUNNEL_TOKEN=
