{
  "regions": ["dub1"],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/src/vercel.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/src/vercel.ts"
    },
    {
      "src": "/sw.js",
      "headers": { "Cache-Control": "no-cache" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/web/$1",
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/web/index.html"
    }
  ]
}
