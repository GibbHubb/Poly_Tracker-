# Copy to .env and fill in values.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/poly_tracker

# Port the API listens on (default: 3001)
# API_PORT=3001

# --- Auth gate (read/write token tiers) ---
# Mutations (POST/PATCH/PUT/DELETE) require the WRITE token.
# GETs require the READ token only when a read token is set; a valid write
# token also satisfies a read check. Leave all unset to run in open mode
# (no auth) for local development.
#
# API_WRITE_TOKEN=   # required for mutations when set
# API_READ_TOKEN=    # when set, GETs also require a token (locks reads)
#
# Legacy: API_TOKEN is honoured as the WRITE token (back-compat). With only
# API_TOKEN set, reads stay open — set API_READ_TOKEN to lock reads too.
# Note: read gate also covers GET /api/photos/file/:id, so <img>-loaded photos
# will 401 when reads are locked (accepted for v1).
# API_TOKEN=

# Directory for uploaded photos
# PHOTO_STORAGE_PATH=/data/photos

# Max size (MB) for a bulk GeoJSON import upload (POST /api/import/geojson).
# Default: 25
# IMPORT_MAX_MB=25
