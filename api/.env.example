# Copy to .env and fill in values.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/poly_tracker

# Port the API listens on (default: 3001)
# API_PORT=3001

# Shared bearer token for mutating requests (POST/PATCH/DELETE).
# Leave empty or unset to run in open mode (no auth) for local development.
# API_TOKEN=

# Directory for uploaded photos
# PHOTO_STORAGE_PATH=/data/photos
